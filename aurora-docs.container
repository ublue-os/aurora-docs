[Container]
ContainerName=aurora-docs
Exec=bash -c 'npm i . && npm run build && npm run serve'
Image=docker.io/library/node:latest@sha256:f8e5d4bb28fa55c74f1345166a082a10b7c68f22304350c1ce0d18358ae94996
Network=host
PublishPort=3000:3000
Volume=%h/path/to/aurora-docs/repo:/srv/docs:Z
WorkingDir=/srv/docs
