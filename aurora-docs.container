[Container]
ContainerName=aurora-docs
Exec=bash -c 'npm i . && npm run build && npm run serve'
Image=docker.io/library/node:latest@sha256:e18c3ccdf7d71619990b0e85639f506e2028a95410999cab24cc373cbd10e0ac
Network=host
PublishPort=3000:3000
Volume=%h/path/to/aurora-docs/repo:/srv/docs:Z
WorkingDir=/srv/docs
