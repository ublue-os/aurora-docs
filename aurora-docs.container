[Container]
ContainerName=aurora-docs
Exec=bash -c 'npm i . && npm run build && npm run serve'
Image=docker.io/library/node:latest@sha256:438603bbb5cda404b9416f0b5c8026f61501ab911760d861ec28c36b5d675725
Network=host
PublishPort=3000:3000
Volume=%h/path/to/aurora-docs/repo:/srv/docs:Z
WorkingDir=/srv/docs
